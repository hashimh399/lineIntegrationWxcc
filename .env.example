# Server
PORT=4000
NODE_ENV=production

# Webex service app (Developer Portal). The refresh token is only used when Redis has none.
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
WEBEX_INITIAL_REFRESH_TOKEN=
WEBEX_ORG_ID=

# Webex Contact Center
WXCC_API_BASE_URL=https://api.wxcc-in1.cisco.com
# Secret configured on the Custom Messaging asset webhook (posts agent replies to /webhook).
WXCC_WEBHOOK_SECRET=
# Secret set on the Webex Subscription that posts task:new/ended/failed to /lifecycle.
WXCC_SUBSCRIPTION_SECRET=
# off | log | enforce. Use log until real Webex events show "signature valid", then enforce.
WXCC_WEBHOOK_SIGNATURE_MODE=log
# Optional. Redis TTL for customer-to-task mappings, in seconds. Default 14 days.
WXCC_TASK_TTL_SECONDS=
# Optional. Skip a flow (system) message identical to one sent to the same customer within
# this many seconds. Agent replies are never skipped. Default 300; 0 disables.
WXCC_SYSTEM_MESSAGE_DEDUPE_SECONDS=

# Redis. Use rediss:// for TLS (for example ElastiCache with in-transit encryption).
REDIS_URL=redis://127.0.0.1:6379

# LINE (Messaging API channel)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_WXCC_ASSET_ID=
LINE_WXCC_CHANNEL_NAME=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WXCC_ASSET_ID=
TELEGRAM_WXCC_CHANNEL_NAME=

# Third-party chat widget (optional)
WIDGET_API_KEY=
WIDGET_CALLBACK_URL=
WIDGET_CALLBACK_SECRET=
WIDGET_WXCC_ASSET_ID=
WIDGET_WXCC_CHANNEL_NAME=
WIDGET_INITIATION_TEXT=Customer started a chat
